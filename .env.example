# Copy to .env.local for `npm run dev`. Docker Compose reads .env.docker.
# Values below match a local `npx supabase start`; run `npx supabase status`
# to confirm the keys on your machine.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used by `npm run test:db`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ID verification. "simulated" (default) shows a test page where you pick the
# result, so the whole flow works locally without Stripe. Production uses
# "stripe" with your Stripe secret key and the Identity webhook secret.
IDENTITY_PROVIDER=simulated
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_...
