# Settings for local development. Don't copy keys in by hand: with Supabase
# running (npm run db:start), run `npm run env:local`. It writes the URLs and
# keys from your local Supabase into .env.local (and .env for Docker).
# Neither file is committed. This file only documents the settings.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used by `npm run test:db`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ID verification. "simulated" (default) shows a test page where you pick the
# result, so the whole flow works locally without Stripe. Production uses
# "stripe" with your Stripe secret key and the Identity webhook secret.
IDENTITY_PROVIDER=simulated
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_...
