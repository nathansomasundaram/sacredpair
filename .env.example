# Settings for local development. Don't copy keys in by hand: with Supabase
# running (npm run db:start), run `npm run env:local`. It writes the URLs and
# keys from your local Supabase into .env.local (and .env for Docker).
# Neither file is committed. This file only documents the settings.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used by `npm run test:db`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ID verification. "simulated" (default) shows a test page where you pick the
# result, so the whole flow works locally without Stripe. Production uses
# "stripe" with your Stripe secret key and the Identity webhook secret.
IDENTITY_PROVIDER=simulated

# How members upgrade to Premium. "simulated" offers a free 30-day test
# Premium (local and previews; refused on the production site). "none" shows
# "Premium opens soon". Defaults to simulated, or none on production.
PAYMENTS_PROVIDER=simulated
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_...

# --- Notifications (Settings > Notifications) ---------------------------
# Email notifications go out over SMTP. Locally they land in Mailpit
# (http://localhost:54324) without any setting. In production use your email
# provider's SMTP address, for example smtp://user:password@smtp.resend.com:587
# SMTP_URL=
# EMAIL_FROM=Sacred Pair <hello@sacredpair.com>

# Web push: run `npm run push:keys` to create a key pair in .env.local, and
# copy both values into Vercel. The private key is a secret.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@sacredpair.com

# Text messages: "simulated" (default locally) logs texts and shows phone
# codes on screen; "twilio" sends real texts; "none" turns texting off
# (the default on the production site).
# SMS_PROVIDER=simulated
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
